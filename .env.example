# ============================================================================
# Framecraft configuration. Copy to `.env` and fill in what you need.
# Everything is optional for local development: without keys the app runs in
# development mode with clearly labelled FFmpeg test fixtures (never AI output).
# Never commit `.env`.
# ============================================================================

# ---------------------------------------------------------------- app
NODE_ENV=development
# APP_MODE=production            # forces production checks even if NODE_ENV differs
PORT=4000
HOST=127.0.0.1                   # use 0.0.0.0 inside containers
PUBLIC_APP_URL=http://localhost:3000
PUBLIC_API_URL=http://localhost:4000
LOG_LEVEL=info

# ---------------------------------------------------------------- database
# Local dev default: embedded PostgreSQL (PGlite) stored in apps/server/.data — no Docker needed.
# Production: a real PostgreSQL URL, e.g. postgres://framecraft:secret@db:5432/framecraft
DATABASE_URL=pglite:./.data/pglite
# DATABASE_POOL_SIZE=10
# Optional, only used if you later enable Redis-backed rate limiting.
# REDIS_URL=redis://localhost:6379

# ---------------------------------------------------------------- security
# Required in production. Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=
STORAGE_SIGNING_SECRET=
SESSION_TTL_DAYS=30
# COOKIE_SECURE=true             # defaults to true in production

# ---------------------------------------------------------------- object storage
# local = files under STORAGE_LOCAL_DIR served via signed URLs (dev only).
# s3    = Cloudflare R2 / AWS S3 / MinIO. Required in production so providers can fetch inputs.
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./.data/storage
# S3_ENDPOINT=https://<accountid>.r2.cloudflarestorage.com
# S3_REGION=auto
# S3_BUCKET=framecraft-media
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_FORCE_PATH_STYLE=false      # true for MinIO
MAX_UPLOAD_MB=200

# ---------------------------------------------------------------- media
# Bundled FFmpeg is used by default. Point to a modern build (6.x/7.x) for xfade transitions.
# FFMPEG_PATH=/usr/bin/ffmpeg
# FFPROBE_PATH=/usr/bin/ffprobe
# FFMPEG_FONT_FILE=/usr/share/fonts/truetype/dejavu/DejaVuSans.ttf

# ---------------------------------------------------------------- safety switches
# Paid provider calls are impossible until this is true AND a provider key is set.
LIVE_GENERATION_ENABLED=false
# Labelled FFmpeg test fixtures when live generation is unavailable (forced off in production).
DEV_FIXTURES_ENABLED=true
# Hard global kill-switch for provider spend per UTC day (USD).
GLOBAL_DAILY_PROVIDER_BUDGET_USD=50
# Free credits for new accounts. Default: 300 in development, 0 in production (pay first).
# SIGNUP_BONUS_CREDITS=0

# ---------------------------------------------------------------- access control
# open | invite | closed. Default: open in development, invite in production.
# SIGNUP_MODE=invite
# Who may register in invite mode: emails and/or @domains, comma separated.
SIGNUP_ALLOWLIST=
# Buying credits needs a confirmed email (default: on in production; needs EMAIL_PROVIDER=resend).
# REQUIRE_EMAIL_VERIFICATION=true
# Cloudflare Turnstile (bot check on sign-up / sign-in) — required for SIGNUP_MODE=open in production.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Daily credit cap for every new account (default: 1000 in production, none in development).
# DEFAULT_DAILY_SPEND_LIMIT=1000

# ---------------------------------------------------------------- video providers
# Runway Developer API — https://dev.runwayml.com (credits are $0.01 each)
RUNWAYML_API_SECRET=
# fal.ai — https://fal.ai/dashboard/keys
FAL_KEY=
# LTX API — https://console.ltx.io
LTX_API_KEY=
# Google Gemini API (Veo / Omni) — https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Replicate — https://replicate.com/account/api-tokens (no models enabled by default)
REPLICATE_API_TOKEN=
# Public HTTPS base URL for provider webhooks (fal.ai). Without it jobs are polled.
# PROVIDER_WEBHOOK_BASE_URL=https://app.example.com
PROVIDER_POLL_INTERVAL_MS=6000

# ---------------------------------------------------------------- AI Director (LLM)
# Anthropic Claude — https://console.anthropic.com. Without it the offline planner is used.
ANTHROPIC_API_KEY=
LLM_MODEL_FAST=claude-haiku-5-5
LLM_MODEL_SMART=claude-opus-5-5

# ---------------------------------------------------------------- audio
# ElevenLabs — https://elevenlabs.io/app/settings/api-keys (TTS incl. Georgian, music, SFX, STT)
ELEVENLABS_API_KEY=

# ---------------------------------------------------------------- payments
# sandbox = simulated checkout for development (disabled in production)
# stripe  = Stripe Checkout + webhooks (verify Stripe supports your merchant country first)
PAYMENT_PROVIDER=sandbox
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ---------------------------------------------------------------- OAuth (architecture ready; flow not enabled yet)
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# ---------------------------------------------------------------- email
EMAIL_PROVIDER=console
RESEND_API_KEY=
EMAIL_FROM=Framecraft <no-reply@example.com>

# ---------------------------------------------------------------- workers
# With PGlite the API runs the worker in-process. With PostgreSQL run `pnpm dev:worker` / the worker container.
# EMBEDDED_WORKER=false
WORKER_CONCURRENCY=4
# WORKER_QUEUES=generation,media,maintenance
